  {
    "Name": "burst: 3 requests, free",
    "Method": "POST",
    "Path": "/api/governance/burst",
    "Body": {
      "profileId": "prod-us",
      "keyAlias": "PROD_TOOL_BLOCKING",
      "scheme": "bearer",
      "count": 3
    },
    "Volatile": [
      {
        "Pattern": "elapsedMs",
        "Why": "wall-clock duration of the burst"
      },
      {
        "Pattern": "firstExchangeId",
        "Why": "a fresh uuid per exchange"
      },
      {
        "Pattern": "rejectedExchangeId",
        "Why": "same"
      }
    ]
  }
