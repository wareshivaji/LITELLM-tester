  },
  {
    "Name": "preflight: all six checks",
    "Method": "POST",
    "Path": "/api/preflight",
    "Body": {
      "profileId": "prod-us",
      "keyAlias": "PROD_TOOL_BLOCKING",
      "scheme": "bearer"
    },
    "Volatile": [
      {
        "Pattern": "exchangeId",
        "Why": "a fresh uuid per exchange"
      },
      {
        "Pattern": "exchangeIds.*",
        "Why": "same, in the preflight response"
      },
      {
        "Pattern": "startedAt",
        "Why": "wall-clock instant"
      },
      {
        "Pattern": "durationMs",
        "Why": "wall-clock duration"
      },
      {
        "Pattern": "checks.*.latencyMs",
        "Why": "per-check network timing"
      },
      {
        "Pattern": "checks.*.detail",
        "Why": "the health check's detail embeds its own latency in ms"
      },
      {
        "Pattern": "metrics",
        "Why": "the gateway's live counters move between the two calls"
      }
    ]
  },
