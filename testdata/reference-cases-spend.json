    "Name": "SPEND chat: a minimal real completion",
    "Method": "POST",
    "Path": "/v1/chat/completions",
    "Body": {
      "model": "bedrock-claude-haiku-4.5",
      "messages": [
        {
          "role": "user",
          "content": "Reply with the single word: ok"
        }
      ],
      "max_tokens": 5
    },
    "Volatile": [
      {
        "Pattern": "created",
        "Why": "unix timestamp of the call"
      },
      {
        "Pattern": "choices.*.message.content",
        "Why": "model output is not deterministic"
      },
      {
        "Pattern": "usage.*",
        "Why": "token counts vary with the provider's tokeniser"
      },
      {
        "Pattern": "model",
        "Why": "each gateway names the underlying model differently"
      },
      {
        "Pattern": "system_fingerprint",
        "Why": "provider build identifier"
      }
    ],
    "Skip": "not comparable without a provider credential on LiteLLM: TokenShield succeeds, LiteLLM fails at the provider, so the diff shows a transport difference rather than a contract one. Nothing is learned."
