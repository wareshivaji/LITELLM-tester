  {
    "Name": "SPEND chat: named tool_choice — does it actually restrict?",
    "Method": "POST",
    "Path": "/v1/chat/completions",
    "Body": {
      "model": "bedrock-claude-haiku-4.5",
      "messages": [
        {
          "role": "user",
          "content": "what is 2+2?"
        }
      ],
      "tools": [
        {
          "type": "function",
          "function": {
            "name": "adder",
            "description": "adds",
            "parameters": {
              "type": "object",
              "properties": {
                "a": {
                  "type": "number"
                }
              }
            }
          }
        },
        {
          "type": "function",
          "function": {
            "name": "greeter",
            "description": "greets",
            "parameters": {
              "type": "object",
              "properties": {}
            }
          }
        }
      ],
      "tool_choice": {
        "type": "function",
        "function": {
          "name": "greeter"
        }
      },
      "max_tokens": 60
