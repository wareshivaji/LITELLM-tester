    "Volatile": [
      {
        "Pattern": "created",
        "Why": "unix timestamp"
      },
      {
        "Pattern": "usage.*",
        "Why": "token counts"
      },
      {
        "Pattern": "model",
        "Why": "underlying model naming"
      },
      {
        "Pattern": "choices.*.message.tool_calls.*.function.arguments",
        "Why": "argument values vary"
      }
    ],
    "Skip": "not comparable without a provider credential on LiteLLM: whether tool_choice restricts is only observable in a successful completion."
