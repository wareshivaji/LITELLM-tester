  {
    "Name": "FREE responses: OpenAI's documented tool-continuation with a shorthand user turn",
    "Method": "POST",
    "Path": "/v1/responses",
    "Body": {
      "model": "bedrock-claude-haiku-4.5",
      "input": [
        {
          "role": "user",
          "content": "what is 2+2?"
        },
        {
          "type": "function_call",
          "call_id": "call_1",
          "name": "adder",
          "arguments": "{\"a\":2,\"b\":2}"
        },
        {
          "type": "function_call_output",
          "call_id": "call_1",
          "output": "4"
        }
      ],
      "tools": [
        {
          "type": "function",
          "name": "adder",
          "description": "adds two numbers",
          "parameters": {
            "type": "object",
            "properties": {
              "a": {
                "type": "number"
              },
              "b": {
                "type": "number"
              }
            }
          }
        }
      ],
      "max_output_tokens": 20
    }
  },
  {
    "Name": "FREE chat: a declared type:mcp tool block (OpenAI documents 400; TokenShield measured 403)",
    "Method": "POST",
    "Path": "/v1/chat/completions",
    "Body": {
      "model": "bedrock-claude-haiku-4.5",
      "messages": [
        {
          "role": "user",
          "content": "list the tools you have"
