# Dependencies
node_modules/

# Build output
dist/
.vite/
*.tsbuildinfo

# Secrets — the ONLY file that ever holds a raw cg-ak-/cg-mk- key.
# Never commit it. .env.example is the documented, key-free template.
.env
.env.*
# ...except the template, which must be committed and must never hold a
# real value. The rule above would otherwise swallow it.
!.env.local.example
!.env.example

# Exported run reports (Phase 7). Local evidence, not source.
out/*
!out/.gitkeep

# Misc
*.log
.DS_Store
Thumbs.db
coverage/

# Go build output
bin/
