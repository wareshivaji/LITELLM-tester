# Copy to .env.local and fill in. Both repos read this same file: the engine
# loads it from the client-sdk checkout beside it.
#
# .env.local is gitignored. This example is force-added past that rule, so
# NEVER put a real value in here.

# ── where the engine listens ───────────────────────────────────────────────
# The Vite dev server reads this to know where to proxy /api, so the number
# lives in one place. 8801 is also the engine's own default.
TSLAB_PORT=8801

TSLAB_HISTORY_LIMIT=200
TSLAB_TIMEOUT_MS=60000

# ── gateways ───────────────────────────────────────────────────────────────
# TSLAB_PROFILE_<ID>=<label>|<base url>
#
# The base URL EXCLUDES /v1. A profile names a gateway, not a surface, and the
# `/v1/...` part belongs to the path — getting this backwards produced a
# /v1/v1/chat/completions once.
TSLAB_PROFILE_LOCAL=Local gateway|http://localhost:4000
TSLAB_PROFILE_PROD_US=Prod US|https://gateway.cloudgov.ai
TSLAB_PROFILE_PROD_MUMBAI=Prod Mumbai|https://gateway-mumbai.cloudgov.ai

# Which one is selected when nothing says otherwise.
TSLAB_DEFAULT_PROFILE=local

# ── credentials ────────────────────────────────────────────────────────────
# TSLAB_KEY_<ALIAS>=<secret>
#
# One slot per alias, and there is NO bare default: an unresolvable alias fails
# loudly rather than falling back. A lab that silently drops your credential
# runs unauthenticated, gets a 401, and reports the target as down — which is
# worse than crashing.
#
# The environment can supply a slot instead of this file, under the same name.
TSLAB_KEY_MY_KEY=cg-ak-REPLACE-ME
TSLAB_DEFAULT_KEY=MY_KEY

# A key that is deliberately invalid. Worth having: `npm run parity` runs the
# whole /api/compare gate on it, so the gate costs nothing, and a 401 through a
# real vendor SDK is the most informative case that surface has.
TSLAB_KEY_INVALID_ON_PURPOSE=cg-ak-0000000000000000000000000000000000000000

# A management key, for the mint/budget surfaces. Note the cg-mk- prefix — the
# lab warns rather than fails if a slot carries the wrong kind, because the
# gateway's own behaviour on a mismatched prefix is one of the things under test.
# TSLAB_KEY_MY_MGMT_KEY=cg-mk-REPLACE-ME

# ── optional ───────────────────────────────────────────────────────────────
# Where the mock MCP server is advertised. Defaults to the engine's own origin,
# which is where it lives. Override only to point a `declared` case at a mock in
# another process, or at a real MCP server.
# TSLAB_MOCK_MCP_ORIGIN=http://127.0.0.1:8801

# How the engine runs the Node probe. Set this to skip `npm run build:probe`
# and drive it from source instead.
# TSLAB_PROBE_CMD=npx tsx ../tokenshield-client-sdk/packages/probe/src/probe.ts
