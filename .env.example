# ─────────────────────────────────────────────────────────────────────────────
# TokenShield Lab — local config template
#
# Copy to `.env.local` (gitignored) and fill in. `.env.local` is the ONLY file
# that holds raw keys, and it is the ONLY source the lab reads them from.
#
# WHY THE `TSLAB_` PREFIX: the Python compat-test suite already uses TS_KEY /
# TOKENSHIELD_API_KEY / TOKENSHIELD_BASE_URL, and those persist across a
# PowerShell session. A stale one silently sending a run at the wrong gateway
# cost ~2h of debugging once. Nothing here collides with those names, and the
# lab reads keys from the FILE ONLY — never from the ambient environment — so
# a leftover shell variable cannot hijack a run.
# ─────────────────────────────────────────────────────────────────────────────

# ── Lab server ───────────────────────────────────────────────────────────────
# Backend port. Bound to 127.0.0.1 only — never expose this console.
TSLAB_PORT=8787
# How many exchanges the in-memory ring buffer keeps. No database, by design.
TSLAB_HISTORY_LIMIT=200
# Per-request timeout in ms.
TSLAB_TIMEOUT_MS=60000

# ── Profiles: TSLAB_PROFILE_<ID>=<label>|<baseUrl> ───────────────────────────
# <ID> becomes the profile id (lowercased, underscores → hyphens).
# baseUrl has NO /v1 suffix — the SDK appends the right path per surface.
TSLAB_PROFILE_LOCAL=Local gateway|http://localhost:4000
TSLAB_PROFILE_PROD_US=Prod US|https://gateway.cloudgov.ai
TSLAB_PROFILE_PROD_MUMBAI=Prod Mumbai|https://gateway-mumbai.cloudgov.ai

# Which profile the UI selects on load.
TSLAB_DEFAULT_PROFILE=local

# ── API keys: TSLAB_KEY_<ALIAS>=cg-ak-... ────────────────────────────────────
# <ALIAS> is what the UI shows. Raw values stay in the backend's memory and are
# masked (cg-ak-abcd…wxyz) in every response, every log line and every export.
# TSLAB_KEY_GLM_TESTING=cg-ak-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TSLAB_KEY_BEDROCK_TEST=cg-ak-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Which key alias the UI selects on load (optional).
# TSLAB_DEFAULT_KEY=GLM_TESTING

# ── Management keys: TSLAB_MGMT_<ALIAS>=cg-mk-... (Phase 5) ──────────────────
# Used only by the Keys page to mint disposable cg-ak- keys.
# TSLAB_MGMT_DEFAULT=cg-mk-xxxxxxxxxxxxxxxx

# ── Admin keys: TSLAB_ADMIN_<ALIAS>=... (Phase 5, cache endpoints) ───────────
# TSLAB_ADMIN_LOCAL=xxxxxxxx
